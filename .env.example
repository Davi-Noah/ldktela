# Copie para .env e preencha. NUNCA versione o .env.
# Nomes desta lista sao normativos: nao invente variantes.

# ---------- Servidor ----------
APP_ENV=development                 # development | production
BIND_ADDR=0.0.0.0:8080
PUBLIC_BASE_URL=http://localhost:8080
RUST_LOG=info,server=debug,api=debug,bot=debug

# ---------- Banco ----------
DATABASE_URL=postgres://comms:comms@127.0.0.1:5432/comms
DATABASE_MAX_CONNECTIONS=10

# Necessario para o cache offline do SQLx em ambiente sem banco (CI, agente).
SQLX_OFFLINE=true

# ---------- Autenticacao ----------
# Gere com: openssl rand -base64 48
JWT_SIGNING_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Nao ha senha neste produto: a identidade e a conta do Discord, alcancada por
# um codigo de pareamento emitido pelo bot (ADR-0009). Por isso nao ha Argon2.

# ---------- Discord ----------
# Token do bot. Sem ele nao ha identidade nem autorizacao, e o processo recusa
# subir: melhor falhar no boot do que servir 503 para todo mundo.
DISCORD_BOT_TOKEN=
# Quanto tempo o gateway pode ficar fora antes de admissoes falharem fechadas
# (RF-09, P-02). Uma reconexao curta nao pode recusar ninguem.
DISCORD_REPLICA_GRACE_SECONDS=60
# Vida do codigo de pareamento (P-03) e teto de emissao por conta por hora.
PAIRING_CODE_TTL_SECONDS=300
PAIRING_MAX_CODES_PER_HOUR=10

# ---------- LiveKit (auto-hospedado) ----------
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WEBHOOK_PATH=/api/v1/internal/livekit/webhook
ROOM_TOKEN_TTL_SECONDS=3600         # RNF-06: <= 60 min, imposto tambem em codigo
ROOM_MAX_PUBLISHERS=2               # P-01: telas simultaneas por sala
# O fechamento de sala ociosa e do LiveKit: empty_timeout e departure_timeout
# em docker/livekit.dev.yaml. Nao ha variavel aqui.

# ---------- Gateway WebSocket ----------
WS_HEARTBEAT_INTERVAL_MS=30000
WS_SESSION_TTL_MS=90000
WS_RESUME_BUFFER_SIZE=500
WS_MAX_CONNECTIONS_PER_USER=4

# ---------- Operacao ----------
EGRESS_BUDGET_GB_PER_MONTH=6000     # RNF-05: 60% da franquia de 10 TB
EGRESS_ALERT_THRESHOLD=0.7
BACKUP_CRON="0 4 * * *"
BACKUP_RETENTION_DAYS=14

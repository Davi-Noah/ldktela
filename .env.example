# Copie para .env e preencha. NUNCA versione o .env.
# Nomes desta lista sao normativos: nao invente variantes.

# ---------- Servidor ----------
APP_ENV=development                 # development | production
BIND_ADDR=0.0.0.0:8080
PUBLIC_BASE_URL=http://localhost:8080
RUST_LOG=info,server=debug,api=debug,bridge=debug

# ---------- Banco ----------
DATABASE_URL=postgres://comms:comms@127.0.0.1:5432/comms
DATABASE_MAX_CONNECTIONS=10

# Necessario para o cache offline do SQLx em ambiente sem banco (CI, agente).
SQLX_OFFLINE=true

# ---------- Autenticacao ----------
# Gere com: openssl rand -base64 48
JWT_SIGNING_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Argon2id — RNF-06. Nao reduza sem discutir.
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4

# ---------- Cloudflare R2 ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=comms-media
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://media.exemplo.com
R2_PRESIGN_TTL_SECONDS=300

# ---------- LiveKit (auto-hospedado) ----------
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WEBHOOK_PATH=/api/v1/internal/livekit/webhook
VOICE_TOKEN_TTL_SECONDS=3600        # RNF-07: <= 60 min
VOICE_MAX_CAMERA_PUBLISHERS=3       # RNF-10
# O fechamento de sala ociosa (RNF-10) e do LiveKit: empty_timeout e
# departure_timeout em docker/livekit.dev.yaml. Nao ha variavel aqui.

# ---------- Ponte Discord ----------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
BRIDGE_ENABLED=false
BRIDGE_RATE_LIMIT_PER_MINUTE=25
BRIDGE_RECONCILE_WINDOW_DAYS=7      # RF-31a
# Tokens de webhook, um por canal. O banco guarda so a referencia (RNF-15).
# Formato: DISCORD_WEBHOOK_<REFERENCIA>=<token>
# DISCORD_WEBHOOK_GERAL=

# ---------- Limites (RF-11a) ----------
MAX_ATTACHMENT_BYTES=26214400       # 25 MB
MAX_ATTACHMENTS_PER_MESSAGE=10
ALLOWED_CONTENT_TYPES=image/webp,image/png,image/jpeg,image/gif,video/mp4,audio/mpeg,application/pdf,text/plain

# ---------- Gateway WebSocket ----------
WS_HEARTBEAT_INTERVAL_MS=30000
WS_SESSION_TTL_MS=90000
WS_RESUME_BUFFER_SIZE=500
WS_MAX_CONNECTIONS_PER_USER=4

# ---------- Operacao ----------
EGRESS_BUDGET_GB_PER_MONTH=6000     # RNF-10: 60% da franquia de 10 TB
EGRESS_ALERT_THRESHOLD=0.7
BACKUP_CRON="0 4 * * *"
BACKUP_RETENTION_DAYS=14

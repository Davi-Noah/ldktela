{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT p.user_id,\n               u.discord_user_id,\n               u.username,\n               u.display_name,\n               u.avatar_url,\n               p.publishing,\n               p.joined_at\n          FROM room_presence p\n          JOIN users u ON u.id = p.user_id\n         WHERE p.discord_channel_id = $1\n         ORDER BY p.joined_at\n        ",

  "db_name": "PostgreSQL",
  "query": "\n        SELECT message_id, emoji,\n               COUNT(*) AS \"count!\",\n               bool_or(user_id = $2) AS \"me!\"\n        FROM reactions\n        WHERE message_id = ANY($1)\n        GROUP BY message_id, emoji\n        ORDER BY MIN(created_at)\n        ",

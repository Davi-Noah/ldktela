  "query": "\n            UPDATE guilds SET\n                name     = CASE WHEN $2 THEN COALESCE($3, name) ELSE name END,\n                icon_url = CASE WHEN $4 THEN $5 ELSE icon_url END\n            WHERE id = $1\n            RETURNING id, name, icon_url, owner_id, discord_guild_id, created_at\n            ",

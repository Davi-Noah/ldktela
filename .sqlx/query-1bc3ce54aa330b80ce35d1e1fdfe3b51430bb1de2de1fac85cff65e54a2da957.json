  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, channel_id, author_id, content, reply_to_id,\n               is_pinned, edited_at, deleted_at, created_at\n        FROM messages\n        WHERE channel_id = $1 AND deleted_at IS NULL AND id > $2\n        ORDER BY id ASC\n        LIMIT $3\n        ",

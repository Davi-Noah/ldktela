{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT g.id, g.name, g.icon_url, g.owner_id, g.discord_guild_id, g.created_at\n        FROM guilds g\n        JOIN guild_members m ON m.guild_id = g.id\n        WHERE m.user_id = $1 AND m.banned_at IS NULL\n        ORDER BY g.id\n        ",

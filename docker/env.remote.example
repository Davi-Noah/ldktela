# Arquivo de exemplo para ambiente remoto

# ---------- Servidor ----------
APP_ENV=production
BIND_ADDR=0.0.0.0:8080
API_PORT=8090
# URL pública que o app ou clientes usam para falar com a API
PUBLIC_BASE_URL=http://<IP_PUBLICO_VM>:8090
RUST_LOG=info,server=debug,api=debug,bot=debug

# ---------- Banco de Dados ----------
# O host é 'postgres' pois se comunicam dentro da rede do Docker Compose
DATABASE_URL=postgres://comms:comms@postgres:5432/comms
DATABASE_MAX_CONNECTIONS=10
SQLX_OFFLINE=true

# ---------- Autenticação ----------
# Gere uma chave com ao menos 32 caracteres (ex: openssl rand -base64 48)
JWT_SIGNING_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ---------- Discord Bot ----------
# O mesmo token de bot usado no ambiente local
DISCORD_BOT_TOKEN=
DISCORD_REPLICA_GRACE_SECONDS=60
PAIRING_CODE_TTL_SECONDS=300
PAIRING_MAX_CODES_PER_HOUR=10

# ---------- LiveKit ----------
# IMPORTANTE: Endereço entregue ao app desktop para a conexão de mídia WebRTC
LIVEKIT_URL=ws://<IP_PUBLICO_VM>:7880
# O mesmo IP, sem esquema nem porta. O LiveKit o anuncia nos candidatos ICE;
# sem ele o compose recusa subir.
LIVEKIT_NODE_IP=<IP_PUBLICO_VM>
# Estas duas variáveis são a ÚNICA fonte da chave: o compose as injeta no
# container do LiveKit como LIVEKIT_KEYS, e o backend as usa para assinar token.
# Não existe mais chave dentro de docker/livekit.remote.yaml, que é versionado.
#
# Gere o par com o próprio servidor, e não à mão:
#   docker run --rm livekit/livekit-server:v1.13.6 generate-keys
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WEBHOOK_PATH=/api/v1/internal/livekit/webhook
ROOM_TOKEN_TTL_SECONDS=3600
ROOM_MAX_PUBLISHERS=10

# ---------- Gateway WebSocket ----------
WS_HEARTBEAT_INTERVAL_MS=30000
WS_SESSION_TTL_MS=90000
WS_RESUME_BUFFER_SIZE=500
WS_MAX_CONNECTIONS_PER_USER=4


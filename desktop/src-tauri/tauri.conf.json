{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ldktela",
  "version": "2.0.0",
  "identifier": "br.com.ldktela.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ldktela",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "theme": "Dark",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.github.com http://127.0.0.1:8080 ws://127.0.0.1:8080 ws://127.0.0.1:7880 http://192.168.0.9:8080 ws://192.168.0.9:8080 ws://192.168.0.9:7880; img-src 'self' data: blob: https:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEOEFBRjVGQzU1ODJEOTAKUldTUUxWakZYNitLcldreml2Uis1Q3FkMkYvQzdlNFVaMkcwcnpqR2wvYzBPS3RBRU5rMnptOTUK",
      "endpoints": [
        "https://github.com/gbrlevi/ldktela/releases/latest/download/latest.json"
      ]
    }
  }
}
